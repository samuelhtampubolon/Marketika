{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marketika",
  "version": "0.1.0",
  "identifier": "id.marketika.workbench",
  "build": {
    "beforeDevCommand": "pnpm --filter @metrika/app dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --filter @metrika/app build -- --outDir ../desktop/dist",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Marketika",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
