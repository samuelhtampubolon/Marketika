{
  "name": "marketika",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @metrika/app dev",
    "build": "pnpm --filter @metrika/app build",
    "desktop:dev": "pnpm --filter @marketika/desktop dev",
    "desktop:build": "pnpm --filter @marketika/desktop build",
    "codegen": "pnpm --filter @metrika/codegen codegen",
    "verify": "pnpm --filter @metrika/codegen verify",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
